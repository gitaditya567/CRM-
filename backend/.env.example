# --- Dispatch Email (SMTP) ---
SMTP_HOST=mail.teaminspire.co.in
SMTP_PORT=465
SMTP_USER=dispatch@teaminspire.co.in
SMTP_PASS=

# --- WhatsApp Business (Meta Cloud API) ---
# Meta App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with 6 body variables:
# {{1}} client name, {{2}} PO no, {{3}} transporter, {{4}} tracking no, {{5}} dispatch date, {{6}} items
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
# Webhook (callback URL: https://<your-api-domain>/api/communications/whatsapp/webhook)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
